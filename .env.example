# Public site URL used for canonical links, the sitemap, and Open Graph.
# No trailing slash. Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email delivery. Leave CONTACT_PROVIDER empty until you are ready.
# Development, with no provider: the enquiry is saved in .data/enquiries.json and is not emailed.
# Production, with no provider: the form tells the visitor to call or WhatsApp. It does not show success.
# resend: sends through Resend. RESEND_API_KEY, CONTACT_TO_EMAIL, and CONTACT_FROM_EMAIL are all required.
CONTACT_PROVIDER=
RESEND_API_KEY=
CONTACT_TO_EMAIL=sivamsteel17@gmail.com
CONTACT_FROM_EMAIL=

# Optional Google Places API (New). Server only. Never prefix these with NEXT_PUBLIC_.
# Enable Places API (New) in Google Cloud and restrict the key.
# GOOGLE_PLACE_ID must be this business's own Place ID. Do not guess one.
# Google currently returns only a small set of reviews, not the full listing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
